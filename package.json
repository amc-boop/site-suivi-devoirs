{
  "name": "site-suivi-devoirs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plateforme de suivi des révisions et devoirs (1ère générale)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "db:reset": "node --disable-warning=ExperimentalWarning server/seed.js --demo",
    "db:vide": "node --disable-warning=ExperimentalWarning server/seed.js --vide"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "lucide-react": "^1.73.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "vite": "^6.4.6"
  }
}
