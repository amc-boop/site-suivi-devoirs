# Copier ce fichier en .env puis remplir.
# Clé gratuite Gemini (https://aistudio.google.com/apikey). Sans clé, le quiz est désactivé proprement.
GEMINI_API_KEY=
# Modèle utilisé pour le quiz (facultatif). Flash-Lite est rapide ; « gemini-flash-latest » sert de secours.
GEMINI_MODEL=gemini-flash-lite-latest
# Port de l'API (facultatif)
PORT=3001
