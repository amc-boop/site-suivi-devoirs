# Copier ce fichier en .env puis remplir. Ne jamais envoyer .env sur GitHub (il est ignoré).

# --- Quiz (Google Gemini, gratuit : https://aistudio.google.com/apikey) ---
# Sans clé, le quiz est désactivé proprement.
GEMINI_API_KEY=
# Modèle principal (facultatif). Flash-Lite est rapide ; d'autres modèles servent de secours automatiquement.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Mise en ligne (Supabase) ---
# Sans DATABASE_URL, le site utilise une base locale (data/pglite) : parfait pour développer.
# Supabase → bouton « Connect » → « Transaction pooler » (port 6543), avec ton mot de passe de base.
DATABASE_URL=
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → service_role (secrète : jamais dans le navigateur ni sur GitHub)
SUPABASE_SERVICE_ROLE_KEY=

# Port de l'API en local (facultatif)
PORT=3001
